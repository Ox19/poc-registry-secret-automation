      "width": 310.4,
      "height": 22.5,
      "text": "¿Dónde llega a existir el valor?",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "¿Dónde llega a existir el valor?",
