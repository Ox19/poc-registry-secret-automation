      "x": 60,
      "y": 2414,
      "width": 484.99999999999994,
      "height": 22.5,
      "text": "Lo que vale SIEMPRE, venga de donde venga el valor",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Lo que vale SIEMPRE, venga de donde venga el valor",
      "lineHeight": 1.25,
      "baseline": 18.5,
