      "seed": 1523032630,
      "version": 1,
      "versionNonce": 1003793372,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "backgroundColor": "transparent",
      "strokeColor": "#1e1e1e",
      "type": "text",
      "x": 60,
      "y": 2700,
      "width": 455.79999999999995,
      "height": 80,
      "text": "El robot no tiene una llave copiada. Cada vez que\nnecesita entrar, pide un pase firmado que vence solo.\nNo hay nada guardado que alguien pueda robar\nni que haya que estar rotando.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "El robot no tiene una llave copiada. Cada vez que\nnecesita entrar, pide un pase firmado que vence solo.\nNo hay nada guardado que alguien pueda robar\nni que haya que estar rotando.",
      "lineHeight": 1.25,
      "baseline": 76
    },
