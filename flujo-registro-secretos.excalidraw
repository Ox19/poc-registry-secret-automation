    },
    {
      "angle": 0,
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 782620850,
      "version": 1,
      "versionNonce": 1243261107,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "backgroundColor": "transparent",
      "strokeColor": "#1e1e1e",
      "type": "text",
      "x": 1280,
      "y": 146,
      "width": 524.4,
      "height": 140.0,
      "text": "EL ROBOT  ·  le pide a GitHub un papel firmado que dice quién es,\nse lo muestra a Microsoft Entra ID, y recibe un pase que vence solo.\nNo hay ninguna contraseña guardada en ningún lado.\n\nUNA PERSONA  ·  entra con su usuario de la compañía, y puede escribir\nporque está en el grupo del punto 4. No necesita nada más.\n\nLos dos terminan con el MISMO permiso: escribir sí, leer no.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "EL ROBOT  ·  le pide a GitHub un papel firmado que dice quién es,\nse lo muestra a Microsoft Entra ID, y recibe un pase que vence solo.\nNo hay ninguna contraseña guardada en ningún lado.\n\nUNA PERSONA  ·  entra con su usuario de la compañía, y puede escribir\nporque está en el grupo del punto 4. No necesita nada más.\n\nLos dos terminan con el MISMO permiso: escribir sí, leer no.",
      "lineHeight": 1.25,
      "baseline": 136.0
    },
