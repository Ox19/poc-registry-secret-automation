      "x": 1280,
      "y": 112,
      "width": 397.7,
      "height": 22.5,
      "text": "Cómo se identifica cada uno para escribir",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cómo se identifica cada uno para escribir",
      "lineHeight": 1.25,
