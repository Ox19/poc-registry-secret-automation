      "strokeColor": "#1e1e1e",
      "type": "text",
      "x": 720,
      "y": 2496,
      "width": 369.8,
      "height": 100,
      "text": "· Nadie lo teclea ni lo copia y pega.\n· No viaja por correo, chat ni ticket.\n· No queda escrito en el pedido.\n· No queda en el registro de la máquina.\n· Ni el propio robot puede volver a leerlo.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "· Nadie lo teclea ni lo copia y pega.\n· No viaja por correo, chat ni ticket.\n· No queda escrito en el pedido.\n· No queda en el registro de la máquina.\n· Ni el propio robot puede volver a leerlo.",
      "lineHeight": 1.25,
      "baseline": 96
    },
