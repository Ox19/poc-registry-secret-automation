    },
    {
      "angle": 0,
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 491632966,
      "version": 1,
      "versionNonce": 897251268,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "backgroundColor": "transparent",
      "strokeColor": "#1e1e1e",
      "type": "text",
      "x": 60,
      "y": 3576,
      "width": 774.0,
      "height": 100,
      "text": "CAMINO A  ·  nadie ve el valor, nunca. No existe hasta después de la aprobación.\n\nCAMINO B  ·  alguien ya lo vio: se lo mandó el proveedor. Eso no se puede deshacer.\n                  Lo que cambia es que deja de circular y queda registrado quién lo pidió,\n                  quién lo autorizó y quién lo cargó.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CAMINO A  ·  nadie ve el valor, nunca. No existe hasta después de la aprobación.\n\nCAMINO B  ·  alguien ya lo vio: se lo mandó el proveedor. Eso no se puede deshacer.\n                  Lo que cambia es que deja de circular y queda registrado quién lo pidió,\n                  quién lo autorizó y quién lo cargó.",
      "lineHeight": 1.25,
      "baseline": 96
    },
