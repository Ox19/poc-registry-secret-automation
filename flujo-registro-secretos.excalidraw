      "x": 60,
      "y": 2664,
      "width": 368.59999999999997,
      "height": 22.5,
      "text": "¿Por qué no hay contraseñas guardadas?",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "¿Por qué no hay contraseñas guardadas?",
      "lineHeight": 1.25,
