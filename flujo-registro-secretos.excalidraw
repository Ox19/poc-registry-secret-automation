    },
    {
      "angle": 0,
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1600657693,
      "version": 1,
      "versionNonce": 401661777,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "backgroundColor": "transparent",
      "strokeColor": "#1e1e1e",
      "type": "text",
      "x": 1460,
      "y": 1908,
      "width": 421.4,
      "height": 100,
      "text": "El robot no tiene una llave copiada. Cada vez\nque necesita entrar, pide un pase firmado que\ndice exactamente quién es y para qué proyecto.\nLa caja fuerte verifica esa firma y le da permiso\npor un rato. Después el pase se vence solo.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "El robot no tiene una llave copiada. Cada vez\nque necesita entrar, pide un pase firmado que\ndice exactamente quién es y para qué proyecto.\nLa caja fuerte verifica esa firma y le da permiso\npor un rato. Después el pase se vence solo.",
      "lineHeight": 1.25,
      "baseline": 96
    },
    {
      "angle": 0,
